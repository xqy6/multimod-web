PORT=4000
DATA_DIR=./data
STORAGE_ROOT=./storage
MAX_FILE_SIZE_MB=500
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 备份专用令牌，GitHub Actions 下载完整备份时使用
BACKUP_TOKEN=

# 日志与错误上报
LOG_DIR=./logs
LOG_LEVEL=info
# 可选：把服务端日志/错误转发到 Slack、Telegram、Better Stack 等 webhook
LOG_WEBHOOK_URL=
# 可选：独立错误告警 webhook（未配置时复用 LOG_WEBHOOK_URL）
TELEMETRY_WEBHOOK_URL=

# 外部备份（S3 兼容，例如 Cloudflare R2、AWS S3、MinIO）
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=netdisk
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# 可选：备份 zip 推送到的 webhook
BACKUP_WEBHOOK_URL=
BACKUP_KEEP_DAYS=7
